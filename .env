# NoneBot2 + OneBot V11 运行环境配置
# LLOneBot / NapCat 将通过反向 WebSocket 连接到此地址

ENVIRONMENT=prod
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# OneBot V11 适配器配置
# 留空表示不校验 Token（测试环境）
# 生产环境建议设置并与 LLOneBot 的 Token 一致
ONEBOT_ACCESS_TOKEN=

# 超级用户 QQ 号（拥有最高权限，逗号分隔）
SUPERUSERS=[]

# 命令起始字符
COMMAND_START=["/", "!"]
COMMAND_SEP=["."]

# 会话过期时间（秒）
SESSION_EXPIRE_TIMEOUT=3600
